# Copy to .env for local development only. .env is git-ignored.
# Staging and production receive these values from the secret manager, never from a file.
# Generate local secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Local services (infra/compose.yaml) -------------------------------------------------

# Password of the PostgreSQL container superuser. Used only by the container's first-start
# bootstrap (infra/db/local-init.sh); the application never connects as the superuser.
POSTGRES_SUPERUSER_PASSWORD=

# Passwords for the login roles created by infra/db/bootstrap-roles.sql.
HRMS_DB_MIGRATOR_PASSWORD=
HRMS_DB_APP_PASSWORD=
HRMS_DB_WORKER_PASSWORD=
HRMS_DB_AUDIT_RETENTION_PASSWORD=

# Password of the Redis ACL user used by the rate limiter (infra/redis/start.sh).
REDIS_RATELIMIT_PASSWORD=

# --- Application ------------------------------------------------------------------------

# One of: local, test, staging, production.
APP_ENV=local

# DEBUG is refused in staging and production.
LOG_LEVEL=INFO

# Serve the interactive OpenAPI docs at /api/v1/docs. Refused in staging and production.
API_DOCS_ENABLED=false

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
# Empty means the direct peer address is the client address.
TRUSTED_PROXY_CIDRS=

# PostgreSQL connection per database role (docs/database-design.md §3).
# Staging and production require sslmode=verify-full.
# Local example: postgresql://hrms_app:<password>@127.0.0.1:5433/hrms
DATABASE_URL_APP=
DATABASE_URL_WORKER=
DATABASE_URL_MIGRATOR=
# Audit retention role; used only by the worker's retention job.
DATABASE_URL_AUDIT_RETENTION=

# Rate-limit store (docs/architecture.md §3.1). Staging and production require rediss:// (TLS).
# Local example: redis://hrms_ratelimit:<password>@127.0.0.1:6380/0
REDIS_URL=

# Base64 key (at least 32 bytes) used to HMAC IP addresses and other subjects in rate-limit key names.
# Generate with: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
RATE_LIMIT_KEY_HMAC_KEY=

# The SPA's origin (scheme://host[:port], no path). Unsafe requests must come from it, and
# invite links are built from it. Staging and production require https.
# Local example: http://localhost:5173 (the Vite dev server, which forwards /api to the API)
APP_BASE_URL=

# Field encryption keys for secret and sensitive fields such as TOTP secrets
# (docs/security-architecture.md §6.2): a JSON object of key version -> base64 32-byte key.
# Keep old versions while rows still use them; new values use the active version.
# Generate a key with: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Example shape: {"1": "<base64 key>"}
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_VERSION=1

# Check new passwords against the Have I Been Pwned range API (k-anonymity). The bundled
# common-password list is always checked; this adds the online check.
HIBP_ENABLED=true

# Keyed hash of attempted email addresses (unknown-account sign-ins and reset requests are
# recorded as HMAC-SHA256, never in plaintext). Base64, at least 32 bytes, and different from
# RATE_LIMIT_KEY_HMAC_KEY (one key per purpose).
EMAIL_LOOKUP_HMAC_KEY=

# --- Worker: email outbox (docs/security-architecture.md §3) -------------------------------

# SMTP server the worker sends the outbox through. Local: the Compose mail catcher
# (SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_SECURITY=none). SMTP_SECURITY is starttls, tls or
# none; none is refused outside local and test.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_SECURITY=starttls
# Set both or neither.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Worker: audit integrity (docs/security-architecture.md §8.1) --------------------------

# Ed25519 key that signs audit checkpoints. Worker only; never in the database or the API.
# Generate a key pair locally with: uv run python -m scripts.generate_audit_signing_key (backend/)
# AUDIT_SIGNING_PRIVATE_KEY is the base64 raw 32-byte private key. AUDIT_VERIFY_PUBLIC_KEYS is
# a JSON object of key ID -> base64 raw public key; it must list the signing key's public key
# under AUDIT_SIGNING_KEY_ID, and keeps old keys after a rotation so old checkpoints verify.
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_VERIFY_PUBLIC_KEYS=

# Write-once bucket (S3 Object Lock, compliance mode) for checkpoint anchors.
# Local: the Compose RustFS emulator, S3_ENDPOINT_URL=http://127.0.0.1:9000, S3_REGION=us-east-1,
# AUDIT_ANCHOR_BUCKET=hrms-audit-anchors-local, and access key and secret of your choosing
# (they become the emulator's root credentials). Empty S3_ENDPOINT_URL means AWS S3.
S3_ENDPOINT_URL=
S3_REGION=
AUDIT_ANCHOR_BUCKET=
AUDIT_ANCHOR_ACCESS_KEY_ID=
AUDIT_ANCHOR_SECRET_ACCESS_KEY=

# Months each audit stream is kept before its partitions are removed with a signed tombstone.
# Empty means nothing is removed. No value is assumed: the periods come from Sigvitas
# (docs/database-design.md §9 proposes 84 for the audit log and 24 for security events).
AUDIT_LOG_RETENTION_MONTHS=
SECURITY_EVENTS_RETENTION_MONTHS=
