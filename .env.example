# Copy to .env for local development only. .env is git-ignored.
# Staging and production receive these values from the secret manager, never from a file.
# Generate a base64 32-byte key with (from backend/):
#   uv run python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# --- Application ------------------------------------------------------------------------

# One of: local, test, staging, production.
APP_ENV=local

# DEBUG is refused in staging and production.
LOG_LEVEL=INFO

# Serve the interactive OpenAPI docs at /api/v1/docs. Refused in staging and production.
API_DOCS_ENABLED=false

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
# Empty means the direct peer address is the client address.
TRUSTED_PROXY_CIDRS=

# The SPA's origin (scheme://host[:port], no path). Unsafe requests must come from it, and
# invite links are built from it. Staging and production require https.
# Local example: http://localhost:5173 (the Vite dev server, which forwards /api to the API)
APP_BASE_URL=

# --- MongoDB (ADR-030) ------------------------------------------------------------------

# The local Compose MongoDB, a one-member replica set (infra/compose.yaml). run-backend.cmd sets
# MONGODB_URI and MONGODB_DATABASE itself, so these matter for commands run by hand.
# Staging and production require TLS and a database user; each process has its own user
# (docs/deployment.md §4).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
# Never `hrms` here: that is the production database, and local and test processes refuse it.
MONGODB_DATABASE=hrms_local

# Run the worker's scheduled jobs (email outbox, audit sealing, exports, accrual) inside the API
# process, as on Render. run-backend.cmd sets it. With a separate `python -m app.worker`, false.
RUN_JOBS_IN_API=true
# The worker's database user for the jobs inside the API. Optional locally (MONGODB_URI is used);
# required in staging and production with RUN_JOBS_IN_API=true.
MONGODB_WORKER_URI=
# Audit retention's own database user; required once a retention period below is set. Staging
# and production refuse it (and the periods) with RUN_JOBS_IN_API=true: retention runs only on
# a separate worker there (docs/deployment.md B5).
MONGODB_AUDIT_RETENTION_URI=

# --- Keys (one per purpose; base64, at least 32 bytes) ---------------------------------------

# HMAC of IP addresses and other subjects in rate-limit counter keys.
RATE_LIMIT_KEY_HMAC_KEY=
# Keyed hash of attempted email addresses (unknown-account sign-ins and reset requests).
EMAIL_LOOKUP_HMAC_KEY=
# Signs the 60-second download links of documents and exports.
DOWNLOAD_LINK_HMAC_KEY=

# Field encryption keys for secret and sensitive fields such as TOTP secrets
# (docs/security-architecture.md §6.2): a JSON object of key version -> base64 32-byte key.
# Keep old versions while records still use them; new values use the active version.
# Example shape: {"1": "<base64 key>"}
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_VERSION=1

# Check new passwords against the Have I Been Pwned range API (k-anonymity). The bundled
# common-password list is always checked; this adds the online check.
HIBP_ENABLED=true

# --- Email (docs/security-architecture.md §3) ---------------------------------------------

# resend (Resend's HTTPS API, every deployed environment) or smtp (local and test only).
# Locally smtp sends to the Compose mail catcher, so no real person receives local mail; read it
# at http://127.0.0.1:8025.
EMAIL_TRANSPORT=smtp
# For example: Sigvitas HRMS <hrms@example.com>. With resend: an address on a verified domain.
EMAIL_FROM=
# Required with EMAIL_TRANSPORT=resend: a Resend API key with sending access only.
RESEND_API_KEY=
# With EMAIL_TRANSPORT=smtp: the Compose mail catcher.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
# Set both or neither.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Audit integrity (docs/security-architecture.md §8.1) --------------------------------

# Ed25519 key that signs audit checkpoints. Held by the process running the jobs only.
# Generate a key pair with: uv run python -m scripts.generate_audit_signing_key (backend/)
# AUDIT_SIGNING_PRIVATE_KEY is the base64 raw 32-byte private key. AUDIT_VERIFY_PUBLIC_KEYS is
# a JSON object of key ID -> base64 raw public key; it must list the signing key's public key
# under AUDIT_SIGNING_KEY_ID, and keeps old keys after a rotation so old checkpoints verify.
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_VERIFY_PUBLIC_KEYS=

# Comma-separated mailboxes outside the HRMS that receive the daily audit witness (signed
# checkpoint heads). Required in production; empty elsewhere: no witness is sent. Locally the
# witness goes to the mail catcher.
AUDIT_WITNESS_EMAILS=

# Months each audit stream is kept before its months are removed with a signed tombstone.
# Empty means nothing is removed. No value is assumed: the periods come from Sigvitas
# (docs/database-design.md §9 proposes 84 for the audit log and 24 for security events).
AUDIT_LOG_RETENTION_MONTHS=
SECURITY_EVENTS_RETENTION_MONTHS=

# --- Documents (stored in MongoDB GridFS; scanned by ClamAV) ---------------------------------

# false (the default) refuses uploads: nothing is accepted that could not be scanned (DOC-5).
# true needs ClamAV: CLAMAV_HOST=127.0.0.1, CLAMAV_PORT=3310; run-backend.cmd then starts the
# Compose `scan` profile (about 1.5 GB of memory; the first start downloads signatures).
DOCUMENT_UPLOADS_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
