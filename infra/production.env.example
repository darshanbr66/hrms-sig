# Production configuration (docs/deployment.md §7). A checklist, not a file to load: every
# value is entered in the Render dashboard (or generated by Render, see render.yaml) and in
# Vercel's project settings. Never put real values in this file, in Git, in a VITE_ variable,
# in a chat or in a ticket.
#
# Generate keys on a trusted machine, from backend/:
#   32-byte base64 key:  uv run python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   audit signing pair:  uv run python -m scripts.generate_audit_signing_key
# Production keys are new keys, generated for production only: never copy a value from a local
# .env, a test database or another environment.

# =============================================================================================
# hrms-api (Render web service: the API and, with RUN_JOBS_IN_API, the scheduled jobs)
# =============================================================================================
APP_ENV=production
LOG_LEVEL=INFO
API_DOCS_ENABLED=false
HIBP_ENABLED=true
# The address employees open, the Vercel production domain: https://<hrms domain>, no path.
# Unsafe requests must come from it (CSRF origin check) and invite links are built from it.
APP_BASE_URL=
# CIDRs of the proxies in front of the API whose X-Forwarded-For is trusted. See
# docs/deployment.md §2 (client addresses behind Vercel): decided before go-live.
TRUSTED_PROXY_CIDRS=

# MongoDB Atlas (database hrms). mongodb+srv:// URIs from Atlas "Connect"; each names its own
# database user (docs/deployment.md §4). TLS is refused off, and a URI without a user is refused.
# hrms_app user: the API's requests.
MONGODB_URI=
MONGODB_DATABASE=hrms
RUN_JOBS_IN_API=true
# The scheduled jobs inside the API process. May be the same user and URI as MONGODB_URI; that
# user then needs the hrms_worker role (docs/deployment.md section 4).
MONGODB_WORKER_URI=
# No MONGODB_AUDIT_RETENTION_URI: with RUN_JOBS_IN_API=true the API refuses it, and audit
# retention stays off until a separate worker runs it (docs/deployment.md B5).

# Generated by Render (render.yaml generateValue); listed so nobody sets them by hand.
RATE_LIMIT_KEY_HMAC_KEY=
EMAIL_LOOKUP_HMAC_KEY=
DOWNLOAD_LINK_HMAC_KEY=
# {"1": "<base64 32-byte key>"}. Losing it makes every enrolled authenticator unreadable:
# keep a copy in the company's secret store, outside Render.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_VERSION=1

# Email through Resend's HTTPS API (port 443, so Render's SMTP block does not apply).
EMAIL_TRANSPORT=resend
# For example: Sigvitas HRMS <hrms@<verified sending domain>>
EMAIL_FROM=
# A Resend API key with "Sending access" only, limited to the verified HRMS domain.
RESEND_API_KEY=

# Audit checkpoint signing. The public key is also kept outside Render, with the people who
# verify the audit trail.
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_VERIFY_PUBLIC_KEYS=
# Mailboxes outside the company's HRMS administrators' control (an external auditor, a mailbox at
# another provider) that receive the daily audit witness. Comma-separated. Required: production
# refuses to start without one.
AUDIT_WITNESS_EMAILS=
# No AUDIT_LOG_RETENTION_MONTHS or SECURITY_EVENTS_RETENTION_MONTHS: refused with
# RUN_JOBS_IN_API=true (B5); every audit record is kept.

# No ClamAV in this deployment: uploads are refused, nothing unscanned is accepted (DOC-5).
DOCUMENT_UPLOADS_ENABLED=false

# =============================================================================================
# Migration (operator machine, before a deploy that needs it; never stored in Render)
# =============================================================================================
# hrms_migrator user (readWrite and dbAdmin on hrms). Run, from backend/ or with the image:
#   python -m app.cli migrate --confirm-database hrms
APP_ENV=production
LOG_LEVEL=INFO
MONGODB_URI=
MONGODB_DATABASE=hrms

# =============================================================================================
# Vercel project (frontend/)
# =============================================================================================
# No application variables: the SPA calls /api on its own origin. Never add VITE_ variables
# holding secrets; the build refuses names that look like one (scripts/check-deploy-config.mjs).
# pnpm version from package.json "packageManager":
ENABLE_EXPERIMENTAL_COREPACK=1
