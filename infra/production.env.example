# Production configuration, by service (docs/deployment.md §7). A checklist, not a file to load:
# every value is entered in the Render dashboard (or generated by Render, see render.yaml) and
# in Vercel's project settings. Never put real values in this file, in Git, in a VITE_ variable,
# in a chat or in a ticket. Each process receives only its own credentials
# (docs/security-architecture.md §6.4).
#
# Generate keys on a trusted machine, from backend/:
#   32-byte base64 key:  uv run python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   audit signing pair:  uv run python -m scripts.generate_audit_signing_key
# Production keys are new keys, generated for production only: never copy a value from a local
# .env, a test database or another environment.

# =============================================================================================
# hrms-api (Render web service)
# =============================================================================================
APP_ENV=production
LOG_LEVEL=INFO
API_DOCS_ENABLED=false
HIBP_ENABLED=true
# The address employees open, the Vercel production domain: https://<hrms domain>, no path.
# Unsafe requests must come from it (CSRF origin check) and invite links are built from it.
APP_BASE_URL=
# CIDRs of the proxies in front of the API whose X-Forwarded-For is trusted. See
# docs/deployment.md §2 (client addresses behind Vercel): decided before go-live.
TRUSTED_PROXY_CIDRS=
# hrms_app role. Must end with ?sslmode=verify-full (and sslrootcert when needed, §6).
DATABASE_URL_APP=
# TLS Redis for rate-limit counters only (docs/architecture.md §3.1). Must be rediss://.
REDIS_URL=
# Generated by Render (render.yaml generateValue); listed so nobody sets them by hand.
RATE_LIMIT_KEY_HMAC_KEY=
EMAIL_LOOKUP_HMAC_KEY=
# {"1": "<base64 32-byte key>"}. Losing it makes every enrolled authenticator unreadable:
# keep a copy in the company's secret store, outside Render.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_VERSION=1
# Private documents and exports bucket (AWS S3). Keys of an IAM user limited to this bucket.
S3_REGION=
FILES_BUCKET=
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
# Empty for AWS S3.
S3_ENDPOINT_URL=

# =============================================================================================
# hrms-worker (Render background worker)
# =============================================================================================
APP_ENV=production
LOG_LEVEL=INFO
APP_BASE_URL=
# hrms_worker and hrms_audit_retention roles, both ?sslmode=verify-full.
DATABASE_URL_WORKER=
DATABASE_URL_AUDIT_RETENTION=
# Resend over SMTP (implicit TLS). The password is a Resend API key with sending access only,
# for the verified HRMS sending domain.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USERNAME=resend
SMTP_PASSWORD=
# For example: Sigvitas HRMS <hrms@<verified sending domain>>
SMTP_FROM=
# Audit checkpoint signing (worker only). The public key is also kept outside Render, with the
# people who verify the audit trail.
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PRIVATE_KEY=
AUDIT_VERIFY_PUBLIC_KEYS=
# Write-once anchor bucket (S3 Object Lock, compliance mode). Keys of an IAM user that can only
# put and read objects there, never delete or change retention.
S3_REGION=
S3_ENDPOINT_URL=
AUDIT_ANCHOR_BUCKET=
AUDIT_ANCHOR_ACCESS_KEY_ID=
AUDIT_ANCHOR_SECRET_ACCESS_KEY=
# Same private bucket as the API (the worker scans uploads and writes exports).
FILES_BUCKET=
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
# From Sigvitas's retention policy (docs/database-design.md §9). Empty keeps everything.
AUDIT_LOG_RETENTION_MONTHS=
SECURITY_EVENTS_RETENTION_MONTHS=
# Set by render.yaml from the hrms-clamav private service.
CLAMAV_HOST=
CLAMAV_PORT=3310

# =============================================================================================
# hrms-migrate (Render cron job, run by hand)
# =============================================================================================
APP_ENV=production
LOG_LEVEL=INFO
# hrms_migrator role, ?sslmode=verify-full. Only this service holds it.
DATABASE_URL_MIGRATOR=

# =============================================================================================
# One-time database bootstrap (operator machine, never stored in Render)
# =============================================================================================
# Passwords for infra/db/bootstrap-roles.sql, generated once and kept in the secret store:
# HRMS_DB_MIGRATOR_PASSWORD, HRMS_DB_APP_PASSWORD, HRMS_DB_WORKER_PASSWORD,
# HRMS_DB_AUDIT_RETENTION_PASSWORD.

# =============================================================================================
# Vercel project (frontend/)
# =============================================================================================
# No application variables: the SPA calls /api on its own origin. Never add VITE_ variables
# holding secrets; the build refuses names that look like one (scripts/check-deploy-config.mjs).
# pnpm version from package.json "packageManager":
ENABLE_EXPERIMENTAL_COREPACK=1
